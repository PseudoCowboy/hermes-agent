# Mythos config example. Copy to mythos/config.yaml and edit as needed.
# Environment variables override anything set here.

discord:
  # Either set DISCORD_BOT_TOKEN env var or paste your token here.
  bot_token: null
  guild_id: null
  main_channel_id: null
  # Optional: if set, project channels are nested under this category.
  project_category_id: null

# Per-project state and isolated workspaces. Defaults are under ~/.mythos.
state_dir: ~/.mythos/state
workspace_root: ~/.mythos/workspaces

# CLI invocation. Defaults match the wiring in mythos/config.py — override
# only if you need a different model, endpoint, effort, or binary path.
providers:
  claude:
    command:
      - claude
      - --dangerously-skip-permissions
      - --effort
      - high
      - --print
    env:
      ANTHROPIC_BASE_URL: http://127.0.0.1:4141
      ANTHROPIC_AUTH_TOKEN: dummy
      ANTHROPIC_MODEL: claude-opus-4.7-1m-internal
    timeout_seconds: 1800
  codex:
    command:
      - codex
      - exec
      - -m
      - gpt-5.5
      - -c
      - model_reasoning_effort=high
      - --skip-git-repo-check
    env:
      OPENAI_BASE_URL: http://127.0.0.1:4141/v1
      OPENAI_API_KEY: dummy
    timeout_seconds: 1800
  gemini:
    command:
      - gemini
      - -m
      - gemini-3.1-pro-preview
      - -y
    # Gemini uses the host's preconfigured credentials; no proxy / env needed.
    env: {}
    timeout_seconds: 1800
