# ──────────────────────────────────────────────────────────────────────
# Mythos environment configuration. Copy to `.env` and fill in real
# values, then `set -a; source mythos/.env; set +a` before launching.
# ──────────────────────────────────────────────────────────────────────

# Discord bot credentials (REQUIRED) -----------------------------------
# Obtain by creating a Bot user in the Discord developer portal:
#   https://discord.com/developers/applications
DISCORD_BOT_TOKEN=replace-me-with-bot-token

# The Discord guild (server) the bot lives in.
DISCORD_GUILD_ID=000000000000000000

# The text channel id where users post project intake messages.
MYTHOS_MAIN_CHANNEL_ID=000000000000000000

# Mythos persistent state and workspaces (OPTIONAL) --------------------
# Defaults: ~/.mythos/state.json and ~/.mythos/workspaces
MYTHOS_STATE_PATH=
MYTHOS_WORKSPACE_ROOT=

# Optional YAML overlay for fine-grained CLI tweaks
# MYTHOS_CONFIG_PATH=/path/to/mythos.yaml

# Per-CLI overrides (OPTIONAL — defaults match the spec) ---------------
# Claude Code CLI driving Athena, Prometheus, Atlas
MYTHOS_CLAUDE_BASE_URL=http://127.0.0.1:4141
MYTHOS_CLAUDE_MODEL=claude-opus-4.7-1m-internal

# Codex CLI driving Argus, Hephaestus
MYTHOS_CODEX_BASE_URL=http://127.0.0.1:4141/v1

# Gemini CLI driving Apollo authenticates against Google directly via
# its own preconfigured credentials — no extra env needed here.

# Anthropic / OpenAI / Google credentials -----------------------------
# Mythos itself does NOT read these directly; the underlying CLIs do.
# In benchmark mode the *_BASE_URL values above point at a local proxy,
# so the tokens are dummies. Set real keys here for real usage.
ANTHROPIC_API_KEY=dummy
OPENAI_API_KEY=dummy
# Used by the Gemini CLI (either name works depending on version).
GEMINI_API_KEY=
GOOGLE_API_KEY=
