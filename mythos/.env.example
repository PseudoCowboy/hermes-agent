# Mythos environment template — copy to `.env` and fill in.

# ── Discord bot (REQUIRED) ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=replace-me
DISCORD_GUILD_ID=000000000000000000
MYTHOS_MAIN_CHANNEL_ID=000000000000000000

# Comma-separated user IDs allowed to start projects. Empty = anyone in the
# main channel.
MYTHOS_ALLOWED_USER_IDS=

# ── Mythos paths (OPTIONAL — sane defaults shown) ───────────────────────
MYTHOS_STATE_DIR=~/.hermes/mythos
MYTHOS_WORKSPACE_ROOT=~/.hermes/mythos/workspaces

# ── Anthropic / Claude Code agents (Athena, Prometheus, Atlas) ──────────
# These match the benchmark-required defaults. Override if your proxy
# is on a different URL or you want to point at the real Anthropic API.
ANTHROPIC_BASE_URL=http://127.0.0.1:4141
ANTHROPIC_AUTH_TOKEN=dummy
ANTHROPIC_MODEL=claude-opus-4.7-1m-internal

# ── OpenAI / Codex agents (Argus, Hephaestus) ───────────────────────────
OPENAI_BASE_URL=http://127.0.0.1:4141/v1
OPENAI_API_KEY=dummy

# ── Gemini agent (Apollo) ───────────────────────────────────────────────
# Apollo uses gemini's host credentials by default — leave these unset
# unless you specifically need to override.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
