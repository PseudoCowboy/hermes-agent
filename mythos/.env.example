# --- Discord ---------------------------------------------------------------
# Bot token: create the bot at https://discord.com/developers/applications
# (see mythos/SETUP.md). Required.
DISCORD_BOT_TOKEN=

# Numeric guild (server) ID. Required.
DISCORD_GUILD_ID=

# Numeric channel ID for the main intake channel. Required.
MYTHOS_MAIN_CHANNEL_ID=

# --- Agent backends --------------------------------------------------------
# By default Mythos sends Anthropic and OpenAI traffic to a local relay at
# 127.0.0.1:4141 with placeholder credentials. Override here for direct API
# usage.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Gemini CLI uses your host's preconfigured credentials. If you want to
# override, point one of these at a service account or OAuth setup.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Mythos runtime --------------------------------------------------------
# Path to a copy of mythos/config.yaml.example with your overrides.
MYTHOS_CONFIG=

# Where Mythos writes per-project working directories (default ~/.hermes/mythos).
MYTHOS_WORKSPACE_DIR=
