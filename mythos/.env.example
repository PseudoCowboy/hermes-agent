# --- Mythos required ---
DISCORD_BOT_TOKEN=replace-with-bot-token-from-discord-developer-portal
DISCORD_GUILD_ID=replace-with-server-id
MYTHOS_MAIN_CHANNEL_ID=replace-with-main-channel-id

# --- Mythos optional ---
MYTHOS_PROJECT_CATEGORY_ID=
MYTHOS_WORKSPACES_ROOT=./mythos_workspaces
MYTHOS_STATE_DIR=./mythos_state
MYTHOS_CONFIG=
MYTHOS_USE_FAKE_RUNNERS=false

# --- Per-role overrides (optional). Defaults point at the local proxy ---
# MYTHOS_MAIN_BASE_URL=http://127.0.0.1:4141
# MYTHOS_MAIN_AUTH_TOKEN=dummy
# MYTHOS_MAIN_MODEL=claude-opus-4.7-1m-internal
# MYTHOS_DRAFT_PLAN_BASE_URL=http://127.0.0.1:4141
# MYTHOS_DRAFT_PLAN_AUTH_TOKEN=dummy
# MYTHOS_DRAFT_PLAN_MODEL=claude-opus-4.7-1m-internal
# MYTHOS_BACKEND_BASE_URL=http://127.0.0.1:4141
# MYTHOS_BACKEND_AUTH_TOKEN=dummy
# MYTHOS_BACKEND_MODEL=claude-opus-4.7-1m-internal
# MYTHOS_REVIEW_BASE_URL=http://127.0.0.1:4141/v1
# MYTHOS_REVIEW_AUTH_TOKEN=dummy
# MYTHOS_REVIEW_MODEL=gpt-5.5
# MYTHOS_TEST_BASE_URL=http://127.0.0.1:4141/v1
# MYTHOS_TEST_AUTH_TOKEN=dummy
# MYTHOS_TEST_MODEL=gpt-5.5
# MYTHOS_FRONTEND_MODEL=gemini-3.1-pro-preview

# --- Gemini-specific (Apollo). Gemini CLI reads its own creds; only set if
# you want to override what the CLI already uses on this host. ---
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Provider-level vars (forwarded only if the per-role overrides above are
# unset and the operator wants to point at the real provider APIs) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
