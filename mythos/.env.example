# --- Discord (required) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
MYTHOS_MAIN_CHANNEL_ID=

# --- Anthropic (Claude Code agents: athena, prometheus, atlas) ---
# Defaults assume a local proxy at 127.0.0.1:4141 with a dummy token.
# For real Anthropic, set ANTHROPIC_API_KEY and unset the override below.
ANTHROPIC_API_KEY=
MYTHOS_CLAUDE_BASE_URL=http://127.0.0.1:4141
MYTHOS_CLAUDE_MODEL=claude-opus-4.7-1m-internal

# --- OpenAI / Codex (argus, hephaestus) ---
# Defaults assume the same local proxy.
OPENAI_API_KEY=
MYTHOS_CODEX_BASE_URL=http://127.0.0.1:4141/v1
MYTHOS_CODEX_MODEL=gpt-5.5

# --- Gemini (apollo) ---
# Apollo uses gemini-cli's own preconfigured credentials.
# Set one of these only if you want to override.
GEMINI_API_KEY=
GOOGLE_API_KEY=
MYTHOS_GEMINI_MODEL=gemini-3.1-pro-preview

# --- Mythos service config ---
MYTHOS_STATE_DIR=./mythos_state
MYTHOS_MAX_ITERATIONS=2
