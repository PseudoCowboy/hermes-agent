# ============================================================================
# Mythos environment template. Copy to .env and fill in real values.
# Required values are marked REQUIRED; optional values keep their defaults
# if unset.
# ============================================================================

# ---- Discord (REQUIRED) ----------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Numeric ID of the Discord server (right-click → Copy Server ID).
DISCORD_GUILD_ID=

# Numeric ID of the channel users post intake messages in.
MYTHOS_MAIN_CHANNEL_ID=

# ---- API keys for the underlying CLIs --------------------------------------
# Real keys for the upstream model providers. Unused if your local proxy
# at 127.0.0.1:4141 accepts the default `dummy` token (e.g. benchmark setup).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ---- Per-CLI overrides (OPTIONAL) ------------------------------------------
# Override Claude Code defaults
# MYTHOS_CLAUDE_BASE_URL=http://127.0.0.1:4141
# MYTHOS_CLAUDE_AUTH_TOKEN=dummy
# MYTHOS_CLAUDE_MODEL=claude-opus-4.7-1m-internal

# Override Codex defaults
# MYTHOS_CODEX_BASE_URL=http://127.0.0.1:4141/v1
# MYTHOS_CODEX_API_KEY=dummy
# MYTHOS_CODEX_MODEL=gpt-5.5

# Override Gemini defaults
# MYTHOS_GEMINI_MODEL=gemini-3.1-pro-preview

# ---- Mythos runtime overrides (OPTIONAL) -----------------------------------
# Workspace root on disk
# MYTHOS_WORKSPACE_ROOT=~/mythos/projects

# Logging level (DEBUG, INFO, WARNING, ERROR)
# MYTHOS_LOG_LEVEL=INFO
