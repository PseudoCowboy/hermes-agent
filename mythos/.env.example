# Discord
DISCORD_BOT_TOKEN=replace_with_bot_token
DISCORD_GUILD_ID=000000000000000000
MYTHOS_MAIN_CHANNEL_ID=000000000000000000

# Discord category created by the bot for project channels (optional)
MYTHOS_PROJECT_CATEGORY=mythos-projects

# Where per-project working dirs are written (optional; defaults to ./workspaces)
MYTHOS_WORKSPACE_ROOT=./workspaces

# Per-CLI subprocess timeout in seconds (optional; default 600)
MYTHOS_CLI_TIMEOUT=600

# Optional path to a yaml config file overriding defaults
# MYTHOS_CONFIG=/etc/mythos/config.yaml

# --- Provider creds ---
# Mythos defaults route Claude Code (Athena, Prometheus, Atlas) and Codex
# (Argus, Hephaestus) through a local proxy at http://127.0.0.1:4141 with
# dummy auth. Set the variables below only if you point them at real cloud
# endpoints in mythos.agents.<role> overrides.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Gemini (Apollo) reads its credentials directly. Set whichever your gemini
# CLI install honors:
GEMINI_API_KEY=
GOOGLE_API_KEY=
