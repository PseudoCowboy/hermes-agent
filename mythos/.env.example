# --- Discord ----------------------------------------------------------
DISCORD_BOT_TOKEN=put-your-bot-token-here
DISCORD_GUILD_ID=000000000000000000
MYTHOS_MAIN_CHANNEL_ID=000000000000000000

# --- Anthropic (Claude Code CLI: Athena, Prometheus, Atlas) ----------
# Defaults below match the brief's local proxy assumption. Replace with
# https://api.anthropic.com + your real key to hit the real API.
ANTHROPIC_BASE_URL=http://127.0.0.1:4141
ANTHROPIC_AUTH_TOKEN=dummy
ANTHROPIC_MODEL=claude-opus-4.7-1m-internal
# Alias accepted for convenience: ANTHROPIC_API_KEY is mapped to
# ANTHROPIC_AUTH_TOKEN if the latter is unset.
# ANTHROPIC_API_KEY=

# --- OpenAI (Codex CLI: Argus, Hephaestus) ---------------------------
OPENAI_BASE_URL=http://127.0.0.1:4141/v1
OPENAI_API_KEY=dummy

# --- Google Gemini (Apollo) ------------------------------------------
# Leave unset if `gemini auth login` already populated your home creds.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Mythos tunables -------------------------------------------------
MYTHOS_WORKSPACE_ROOT=./workspaces
MYTHOS_STATE_PATH=./mythos-state.json
MYTHOS_TIMEOUT_SECONDS=600
MYTHOS_MAX_PLANNING_ROUNDS=2
MYTHOS_MAX_HANDOFF_STREAK=6

# --- Optional role-to-runner overrides -------------------------------
# Each must be one of: claude_code | codex | gemini.
# MAIN_RUNNER=claude_code
# DRAFT_PLAN_RUNNER=claude_code
# REVIEW_RUNNER=codex
# TEST_RUNNER=codex
# FRONTEND_RUNNER=gemini
# BACKEND_RUNNER=claude_code
