# Mythos environment file template — copy to .env and fill in.

# --- Discord (required) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MAIN_CHANNEL_ID=
# Optional category to nest project channels under.
DISCORD_PROJECT_CATEGORY_ID=

# --- Optional overrides ---
# MYTHOS_STATE_DIR=~/.mythos/state
# MYTHOS_WORKSPACE_ROOT=~/.mythos/workspaces

# Claude CLI proxy / model overrides (defaults match the build spec).
# MYTHOS_CLAUDE_BASE_URL=http://127.0.0.1:4141
# MYTHOS_CLAUDE_MODEL=claude-opus-4.7-1m-internal

# Codex CLI proxy / model overrides.
# MYTHOS_CODEX_BASE_URL=http://127.0.0.1:4141/v1
# MYTHOS_CODEX_MODEL=gpt-5.5

# Gemini CLI model override.
# MYTHOS_GEMINI_MODEL=gemini-3.1-pro-preview

# --- Underlying CLI auth (consumed by the CLI binaries themselves) ---
# Claude CLI uses a proxy-style ANTHROPIC_AUTH_TOKEN — the proxy substitutes
# the real key. If you bypass the proxy, set ANTHROPIC_API_KEY here too.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=             # If you use Codex without the proxy.
# GEMINI_API_KEY=             # Or GOOGLE_API_KEY — required by gemini CLI.
